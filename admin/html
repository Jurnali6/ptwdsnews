<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | PTWDS News</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
    <style>
        .ql-editor {
            min-height: 250px;
            font-size: 16px;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4 md:p-6">

    <div id="loginSection" class="w-full max-w-md bg-white p-8 rounded-lg shadow-md">
        <div class="text-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800">Login Admin</h2>
            <p class="text-sm text-gray-500">PTWDS News Management System</p>
        </div>
        <form id="loginForm" class="space-y-4">
            <div>
                <label class="block font-semibold mb-1 text-gray-700">Email Admin</label>
                <input type="email" id="loginEmail" class="w-full p-2.5 border rounded focus:ring-2 focus:ring-blue-500 outline-none" placeholder="admin@ptwdsnews.cloud" required>
            </div>
            <div>
                <label class="block font-semibold mb-1 text-gray-700">Password</label>
                <input type="password" id="loginPassword" class="w-full p-2.5 border rounded focus:ring-2 focus:ring-blue-500 outline-none" placeholder="••••••••" required>
            </div>
            <button type="submit" class="w-full bg-blue-900 text-white font-bold py-3 rounded hover:bg-blue-800 transition">
                Masuk ke Dashboard
            </button>
        </form>
    </div>

    <div id="dashboardSection" class="hidden w-full max-w-3xl bg-white p-6 md:p-8 rounded-lg shadow">
        <div class="flex justify-between items-center mb-6 pb-4 border-b">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Tambah Artikel Berita Baru</h2>
                <p class="text-xs text-green-600 font-semibold mt-1">● Terautentikasi: admin@ptwdsnews.cloud</p>
            </div>
            <button id="btnLogout" class="text-xs bg-red-100 text-red-600 px-3 py-1.5 rounded font-semibold hover:bg-red-200">
                Keluar (Logout)
            </button>
        </div>
        
        <form id="articleForm" class="space-y-5">
            <div>
                <label class="block font-semibold mb-1 text-gray-700">Judul Artikel</label>
                <input type="text" id="judul" class="w-full p-2.5 border rounded focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Masukkan judul artikel" required>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block font-semibold mb-1 text-gray-700">Kategori</label>
                    <select id="kategori" class="w-full p-2.5 border rounded focus:ring-2 focus:ring-blue-500 outline-none" required>
                        <option value="Berita Utama">Berita Utama</option>
                        <option value="Opini">Opini</option>
                        <option value="Berita Daerah">Berita Daerah</option>
                        <option value="Pendidikan">Pendidikan</option>
                        <option value="Budaya">Budaya</option>
                    </select>
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-gray-700">Penulis / Redaksi</label>
                    <input type="text" id="penulis" value="Redaksi PTWDS" class="w-full p-2.5 border rounded focus:ring-2 focus:ring-blue-500 outline-none" required>
                </div>
            </div>

            <div>
                <label class="block font-semibold mb-1 text-gray-700">Gambar Utama / Sampul (Auto 16:9)</label>
                <div id="dropArea" class="border-2 border-dashed border-gray-300 p-6 rounded-lg text-center hover:bg-gray-50 cursor-pointer transition">
                    <input type="file" id="uploadSampulFile" accept="image/jpeg, image/png, image/webp" class="hidden">
                    <div id="uploadPlaceholder">
                        <svg class="mx-auto h-12 w-12 text-gray-400 mb-2" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.01" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <p class="text-sm font-medium text-gray-700">Klik di sini untuk upload foto dari galeri</p>
                        <p class="text-xs text-gray-500 mt-1">Otomatis di-crop ke rasio lanskap 16:9 (JPG/PNG)</p>
                    </div>
                    <div id="previewContainer" class="hidden">
                        <img id="previewImage" src="" alt="Preview 16:9" class="max-h-52 mx-auto rounded border shadow object-cover aspect-video">
                        <p id="uploadStatusText" class="text-xs text-green-600 font-semibold mt-2">✓ Gambar di-crop 16:9 & terunggah!</p>
                    </div>
                </div>
                <input type="url" id="gambar" placeholder="URL otomatis terisi..." class="w-full p-2.5 border rounded focus:ring-2 focus:ring-blue-500 outline-none mt-2 text-sm bg-gray-50" required readonly>
            </div>

            <div>
                <label class="block font-semibold mb-1 text-gray-700">Isi Berita</label>
                <p class="text-xs text-gray-500 mb-2">* Foto yang diunggah dari toolbar editor juga otomatis dipotong ke 16:9</p>
                <div class="bg-white rounded border">
                    <div id="editor-container"></div>
                </div>
            </div>

            <button type="submit" id="btnSubmit" class="w-full bg-blue-900 text-white font-bold py-3 rounded hover:bg-blue-800 transition">
                Publikasikan Artikel
            </button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

    <script>
        // =========================================================
        // 1. KONFIGURASI URL & KREDENSIAL IMAGEKIT.IO
        // =========================================================
        const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxK03aPFxnWadssqlubzoxidW_78cPUBJC0z0rttRg_3ItBGBsP42XhhZpZxSJysOrZ2w/exec";
        const IMAGEKIT_PUBLIC_KEY = "public_GDQUCyVsO4E4swVuMvRzBQy51zk="; 
        const IMAGEKIT_URL_ENDPOINT = "https://ik.imagekit.io/ptwdsnewscloud/artikel/";

        // =========================================================
        // 2. FUNGSI PROCESSOR GAMBAR (AUTO CROP 16:9 DINAMIS VIA CANVAS)
        // =========================================================
        function cropImageTo16x9(file, targetWidth = 1280) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.readAsDataURL(file);
                reader.onload = (e) => {
                    const img = new Image();
                    img.src = e.target.result;
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        const ctx = canvas.getContext('2d');

                        const targetRatio = 16 / 9;
                        let sWidth = img.width;
                        let sHeight = img.height;
                        let sx = 0;
                        let sy = 0;

                        // Hitung pemotongan tengah (center-crop) 16:9
                        if (img.width / img.height > targetRatio) {
                            sWidth = img.height * targetRatio;
                            sx = (img.width - sWidth) / 2;
                        } else {
                            sHeight = img.width / targetRatio;
                            sy = (img.height - sHeight) / 2;
                        }

                        const dWidth = Math.min(targetWidth, sWidth);
                        const dHeight = dWidth / targetRatio;

                        canvas.width = dWidth;
                        canvas.height = dHeight;

                        // Render foto ke canvas
                        ctx.drawImage(img, sx, sy, sWidth, sHeight, 0, 0, dWidth, dHeight);

                        // Konversi canvas menjadi File Blob (Format JPG)
                        canvas.toBlob((blob) => {
                            if (!blob) return reject("Gagal memproses gambar.");
                            const processedFile = new File([blob], file.name.replace(/\.[^/.]+$/, "") + "_16x9.jpg", {
                                type: "image/jpeg",
                                lastModified: Date.now()
                            });
                            resolve(processedFile);
                        }, "image/jpeg", 0.88);
                    };
                    img.onerror = (err) => reject("Gagal membaca berkas gambar.");
                };
                reader.onerror = (err) => reject("Gagal mengunggah berkas.");
            });
        }

        // =========================================================
        // 3. FUNGSI UPLOAD FILE KE IMAGEKIT.IO
        // =========================================================
        async function uploadFileToImageKit(file) {
            // Pres / Crop foto ke 16:9 terlebih dahulu
            const croppedFile = await cropImageTo16x9(file);

            const formData = new FormData();
            formData.append('file', croppedFile);
            formData.append('fileName', croppedFile.name);
            formData.append('publicKey', IMAGEKIT_PUBLIC_KEY);
            formData.append('folder', '/artikel');

            const response = await fetch('https://upload.imagekit.io/api/v1/files/upload', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();
            if (result && result.url) {
                return result.url;
            } else {
                throw new Error(result.message || "Gagal upload ke ImageKit");
            }
        }

        // =========================================================
        // 4. KONTROL UPLOAD GAMBAR UTAMA / SAMPUL
        // =========================================================
        const dropArea = document.getElementById('dropArea');
        const uploadFileInput = document.getElementById('uploadSampulFile');
        const uploadPlaceholder = document.getElementById('uploadPlaceholder');
        const previewContainer = document.getElementById('previewContainer');
        const previewImage = document.getElementById('previewImage');
        const inputGambarUrl = document.getElementById('gambar');

        dropArea.addEventListener('click', () => uploadFileInput.click());

        uploadFileInput.addEventListener('change', async () => {
            const file = uploadFileInput.files[0];
            if (!file) return;

            uploadPlaceholder.classList.add('hidden');
            previewContainer.classList.remove('hidden');
            previewImage.src = URL.createObjectURL(file);
            document.getElementById('uploadStatusText').innerText = "⏳ Sedang memotong 16:9 & mengunggah foto...";

            try {
                const uploadedUrl = await uploadFileToImageKit(file);
                inputGambarUrl.value = uploadedUrl;
                previewImage.src = uploadedUrl;
                document.getElementById('uploadStatusText').innerText = "✓ Gambar berhasil dipotong 16:9 & tersimpan di ImageKit!";
            } catch (err) {
                alert("Upload Gagal: " + err.message);
                uploadPlaceholder.classList.remove('hidden');
                previewContainer.classList.add('hidden');
                inputGambarUrl.value = "";
            }
        });

        // =========================================================
        // 5. LOGIKA AUTENTIKASI LOGIN
        // =========================================================
        const loginSection = document.getElementById('loginSection');
        const dashboardSection = document.getElementById('dashboardSection');
        const loginForm = document.getElementById('loginForm');
        const btnLogout = document.getElementById('btnLogout');

        if (sessionStorage.getItem('isAdminLoggedIn') === 'true') {
            showDashboard();
        }

        loginForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value.trim();

            if (email === "admin@ptwdsnews.cloud" && password === "admin") {
                sessionStorage.setItem('isAdminLoggedIn', 'true');
                showDashboard();
            } else {
                alert("Email atau Password salah!");
            }
        });

        btnLogout.addEventListener('click', () => {
            sessionStorage.removeItem('isAdminLoggedIn');
            location.reload();
        });

        function showDashboard() {
            loginSection.classList.add('hidden');
            dashboardSection.classList.remove('hidden');
            document.body.classList.remove('flex', 'items-center', 'justify-center');
        }

        // =========================================================
        // 6. INISIALISASI QUILL EDITOR & TOOLBAR
        // =========================================================
        const quill = new Quill('#editor-container', {
            theme: 'snow',
            placeholder: 'Tulis artikel berita di sini...',
            modules: {
                toolbar: {
                    container: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'color': [] }, { 'background': [] }],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        [{ 'align': [] }],
                        ['link', 'image', 'blockquote'],
                        ['clean']
                    ],
                    handlers: {
                        image: quillImageHandler
                    }
                }
            }
        });

        function quillImageHandler() {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            input.click();

            input.onchange = async () => {
                const file = input.files[0];
                if (!file) return;

                const range = quill.getSelection(true);
                alert("Mengompresi ke 16:9 & mengunggah gambar...");

                try {
                    const uploadedUrl = await uploadFileToImageKit(file);
                    quill.insertEmbed(range.index, 'image', uploadedUrl);
                    quill.setSelection(range.index + 1);
                } catch (err) {
                    alert("Gagal mengunggah foto ke editor: " + err.message);
                }
            };
        }

        // =========================================================
        // 7. MENGIRIM FORM KE GOOGLE APPS SCRIPT
        // =========================================================
        document.getElementById('articleForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const kontenHTML = quill.root.innerHTML;

            if (quill.getText().trim().length === 0) {
                alert("Isi berita tidak boleh kosong!");
                return;
            }

            const btn = document.getElementById('btnSubmit');
            btn.disabled = true;
            btn.innerText = "Mengirim Artikel...";

            const data = {
                action: "post",
                id: Date.now(),
                judul: document.getElementById('judul').value,
                kategori: document.getElementById('kategori').value,
                gambar: document.getElementById('gambar').value,
                penulis: document.getElementById('penulis').value,
                konten: kontenHTML,
                tanggal: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
            };

            try {
                await fetch(SCRIPT_URL, { 
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain' },
                    body: JSON.stringify(data) 
                });

                alert("Artikel berhasil dipublikasikan!");
                e.target.reset();
                quill.setText('');
                uploadPlaceholder.classList.remove('hidden');
                previewContainer.classList.add('hidden');
            } catch (err) {
                alert("Gagal menerbitkan artikel. Periksa koneksi internet Anda.");
            } finally {
                btn.disabled = false;
                btn.innerText = "Publikasikan Artikel";
            }
        });
    </script>
</body>
</html>

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | PTWDS News</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">
    <style>
        .ql-editor { min-height: 250px; font-size: 16px; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-4 md:p-6">

    <!-- BAGIAN LOGIN -->
    <div id="loginSection" class="w-full max-w-md bg-white p-8 rounded-lg shadow-md">
        <div class="text-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800">Login Admin</h2>
            <p class="text-sm text-gray-500">PTWDS News Management System</p>
        </div>
        <form id="loginForm" class="space-y-4">
            <div>
                <label class="block font-semibold mb-1 text-gray-700">Email Admin</label>
                <input type="email" id="loginEmail" class="w-full p-2.5 border rounded focus:ring-2 focus:ring-blue-500 outline-none" placeholder="admin@ptwdsnews.cloud" required>
            </div>
            <div>
                <label class="block font-semibold mb-1 text-gray-700">Password</label>
                <input type="password" id="loginPassword" class="w-full p-2.5 border rounded focus:ring-2 focus:ring-blue-500 outline-none" placeholder="••••••••" required>
            </div>
            <button type="submit" class="w-full bg-blue-900 text-white font-bold py-3 rounded hover:bg-blue-800 transition">
                Masuk ke Dashboard
            </button>
        </form>
    </div>

    <!-- BAGIAN DASHBOARD (Disembunyikan sebelum login) -->
    <div id="dashboardSection" class="hidden w-full max-w-3xl bg-white p-6 md:p-8 rounded-lg shadow">
        <div class="flex justify-between items-center mb-6 pb-4 border-b">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Tambah Artikel Berita Baru</h2>
                <p class="text-xs text-green-600 font-semibold mt-1">● Terautentikasi: admin@ptwdsnews.cloud</p>
            </div>
            <button id="btnLogout" class="text-xs bg-red-100 text-red-600 px-3 py-1.5 rounded font-semibold hover:bg-red-200">
                Keluar (Logout)
            </button>
        </div>
        
        <!-- Form Artikel -->
        <p class="text-gray-500 mb-4">Dashboard berhasil dibuka! (Formulir disederhanakan untuk contoh)</p>
        <button id="btnLogout2" class="w-full bg-red-600 text-white font-bold py-2 rounded hover:bg-red-800">Uji Coba Logout</button>
    </div>

    <script>
        // Logika Login yang tidak error
        const loginSection = document.getElementById('loginSection');
        const dashboardSection = document.getElementById('dashboardSection');
        const loginForm = document.getElementById('loginForm');
        
        // Cek apakah sebelumnya sudah login
        if (sessionStorage.getItem('isAdminLoggedIn') === 'true') {
            showDashboard();
        }

        // Proses saat tombol ditekan
        loginForm.addEventListener('submit', function(e) {
            e.preventDefault(); // Mencegah halaman refresh
            
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value.trim();

            // Cek Kredensial
            if (email === "admin@ptwdsnews.cloud" && password === "admin") {
                sessionStorage.setItem('isAdminLoggedIn', 'true');
                showDashboard();
            } else {
                alert("Gagal: Email atau Password salah!");
            }
        });

        // Tombol Logout
        document.getElementById('btnLogout').addEventListener('click', logout);
        document.getElementById('btnLogout2').addEventListener('click', logout);

        function logout() {
            sessionStorage.removeItem('isAdminLoggedIn');
            location.reload(); // Refresh halaman agar kembali ke login
        }

        // Fungsi menampilkan dashboard
        function showDashboard() {
            loginSection.classList.add('hidden');
            dashboardSection.classList.remove('hidden');
            document.body.classList.remove('flex', 'items-center', 'justify-center');
        }
    </script>
</body>
</html>
